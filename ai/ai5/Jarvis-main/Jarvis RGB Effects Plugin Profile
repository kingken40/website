                                            "height": 128,
                                            "main_pass": {
                                                "fragment_shader": "// --- JARVIS TWEAK PANEL ---\n#define JARVIS_COLOR      vec3(0.0, 0.435, 0.353) // #006f5a\n#define IDLE_SIZE         0.001  // Microscopic starting point\n#define MAX_REACH         0.9    // 1.0 is screen edge, 1.5 reaches corners\n#define SENSITIVITY       1.0    // Global volume gain\n#define GROWTH_EXPONENT   1.0    // HIGHER = stays small longer, then explodes faster\n#define THICKNESS_BASE    1.5    // How fat the ring is\n#define WARP_MULT         0.4    // How much the jaggedness scales with volume\n// ---------------------------\n\nfloat hash(vec2 p) {\n    p = fract(p * vec2(234.34, 435.345));\n    p += dot(p, p + 34.23);\n    return fract(p.x * p.y);\n}\n\nfloat noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float n = mix(mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), f.x),\n                  mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n    return n;\n}\n\nfloat fbm(vec2 p) {\n    float total = 0.0;\n    float amplitude = 0.8;\n    for (int i = 0; i < 4; i++) {\n        total += noise(p) * amplitude;\n        p *= 2.0;\n        amplitude *= 0.5;\n    }\n    return total;\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord.xy / iResolution.xy;\n    vec2 p = uv * 2.0 - 1.0;\n    p.x *= iResolution.x / iResolution.y;\n    float d = length(p);\n    float a = atan(p.y, p.x);\n\n    // 1. Aggressive Volume Sampling\n    float rawVol = (texture(iChannel0, vec2(0.07, 0.0)).x + \n                    texture(iChannel0, vec2(0.15, 0.0)).x + \n                    texture(iChannel0, vec2(0.30, 0.0)).x) / 3.0;\n    \n    float vol = clamp(rawVol * SENSITIVITY, 0.0, 1.0);\n\n    // 2. Exponential Expansion Logic\n    // This is the \"Secret Sauce\": pow(vol, exponent) keeps it small at low values\n    float expansion = pow(vol, GROWTH_EXPONENT) * MAX_REACH;\n    \n    // Displacement (Warp) is now multiplied by vol so it's 0 at idle\n    float displacement = fbm(vec2(a * 3.0, d - iTime * 1.5)) * (vol * WARP_MULT);\n    \n    float radius = IDLE_SIZE + expansion + displacement;\n\n    // 3. Dynamic Ring Rendering\n    float distToRing = abs(d - radius);\n    \n    // Thickness also scales exponentially so it feels \"meaty\" when large\n    float thickness = (THICKNESS_BASE * pow(vol, 2.0)) + 0.005;\n    float ringSharp = smoothstep(thickness, 0.0, distToRing);\n    \n    // Glow that flares up only when the ring expands\n    float glow = 0.05 / (distToRing + 0.005) * (vol * 4.0);\n    \n    vec3 finalColor = JARVIS_COLOR * (ringSharp + glow);\n\n    // 4. Force Blackout at Idle\n    if (vol < 0.01) finalColor = vec3(0.0);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
